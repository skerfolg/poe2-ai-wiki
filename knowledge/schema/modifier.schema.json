{
  "$id": "modifier.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Modifier.data (P1b ④ 모드 풀 — 제작규칙 RC4의 근거)",
  "type": "object",
  "properties": {
    "affix_type": {
      "enum": ["prefix", "suffix", "corrupted", "rune"],
      "description": "접사 종류. prefix/suffix 합산 한도가 RC4 판 규칙의 축"
    },
    "affix_name": {
      "type": "string",
      "description": "접사 이름 (of the Brute…) — corrupted 등은 빈 문자열"
    },
    "texts": {
      "type": "array",
      "items": { "type": "string" },
      "description": "효과 텍스트 줄들 (룬은 per_slot 사용)"
    },
    "per_slot": {
      "type": "object",
      "description": "룬 전용: 슬롯군(armour|caster|weapon)별 효과 줄들",
      "additionalProperties": {
        "type": "array",
        "items": { "type": "string" }
      }
    },
    "group": {
      "type": "string",
      "description": "그룹 배타(RC4): 같은 group의 모드는 한 아이템에 동시에 못 붙는다"
    },
    "ilvl": {
      "type": "integer",
      "minimum": 0,
      "description": "요구 아이템 레벨 (PoB level)"
    },
    "rank": {
      "type": "integer",
      "description": "룬 전용: 룬 등급"
    },
    "mod_tags": {
      "type": "array",
      "items": { "type": "string" }
    },
    "spawn_weights": {
      "type": "object",
      "description": "베이스 태그 → 스폰 가중치 (0 = 그 태그엔 안 뜸). RC4 합법성 판정의 원본",
      "additionalProperties": { "type": "integer" }
    },
    "origins": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": ["item", "item-exclusive", "corrupted", "rune", "flask", "charm", "jewel", "desecrated", "heart-of-the-well"]
      },
      "description": "모드 풀 출처들 (PoB 파일 계보 + desecrated=poe2db 단독 훼손 부여 — 같은 모드가 여러 풀에 실릴 수 있다, 0.5.4b: flask∩charm 24종). heart-of-the-well=우물의 심장 훼손 선택 풀(ModVeiled.lua UniqueHeart*) — 일반 크래프팅 풀과 분리. 획득 방법은 acquisition에"
    },
    "acquisition": {
      "type": "array",
      "items": { "type": "string" },
      "description": "부여 방법 (완전성 기준 ⑧): crafting-currency | essence:<name> | vaal-orb | rune-socket …"
    },
    "pob_key": {
      "type": "string",
      "description": "PoB 원본 키 (역추적용)"
    }
  },
  "required": ["affix_type", "origins"],
  "additionalProperties": true
}
