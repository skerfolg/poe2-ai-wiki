{
  "$id": "skill.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Skill.data (P1b — category는 태그로 추론 가능할 때만 기록)",
  "type": "object",
  "properties": {
    "category": {
      "enum": [
        "attack",
        "spell",
        "minion",
        "buff",
        "aura",
        "channelling",
        "trigger"
      ]
    },
    "damage_types": {
      "type": "array",
      "items": {
        "enum": [
          "physical",
          "fire",
          "cold",
          "lightning",
          "chaos"
        ]
      }
    },
    "cost_resource": {
      "enum": [
        "mana",
        "life",
        "spirit",
        "none"
      ]
    },
    "pob": {
      "$ref": "pob-gate.schema.json"
    }
  },
  "required": [],
  "additionalProperties": true
}
