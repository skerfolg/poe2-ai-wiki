{
  "$id": "passive.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Passive.data (P1b 트리 수집 반영)",
  "type": "object",
  "properties": {
    "kind": {
      "enum": [
        "keystone",
        "notable",
        "small",
        "ascendancy-start",
        "mastery",
        "jewel-socket"
      ]
    },
    "position": {
      "description": "PoB 트리 좌표 공간의 최종 2D 좌표 (TreeData tree.json group/orbit/orbitIndex 산출, PassiveTree.lua 산식) — 주얼 반경 판정과 동일 공간",
      "type": "object",
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        }
      },
      "required": [
        "x",
        "y"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "kind"
  ],
  "additionalProperties": true
}
