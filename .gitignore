# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
# 후행 `/` 없이 — 워크트리에선 `.venv`가 **심링크**라 `.venv/`(디렉터리 전용)에
# 안 걸린다. 격리 워크트리는 이 심링크를 만들어야 돌아가므로(mac 환경) 매번 재발한다.
# 실측 2026-08-07: 그래서 PR #43·#44 병합 커밋에 `.venv` 심링크가 딸려 들어갔다 —
# 머신 절대경로(`/Users/…`)가 정본에 박히는 셈이라 다른 머신·CI에서 끊긴다.
.venv
venv
env/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
htmlcov/

# --- ② 산출물 (재생성 불가·계보 有) : gitignore, 단 위치 지침(AGENTS/CLAUDE)은 추적 ---
/artifacts/*
!/artifacts/AGENTS.md
!/artifacts/CLAUDE.md
!/artifacts/builds/
!/artifacts/sessions/
!/artifacts/feedback/
!/artifacts/live-snapshots/
/artifacts/builds/*
/artifacts/sessions/*
/artifacts/feedback/raw/*
/artifacts/feedback/candidates/*
/artifacts/live-snapshots/*
!.gitkeep

# --- ③ 파생/캐시 (정본에서 재생성 가능) : 전부 gitignore ---
# KB 파생 검색 인덱스 (knowledge/ 에서 self-healing으로 재생성)
/var/*
!/var/.gitkeep
!/var/pob-cache/
!/var/live/
/var/pob-cache/*
/var/live/*
index.sqlite
*.sqlite
*.sqlite3
# 벡터 인덱스 (후속)
*.lance/
.chroma/

# --- PoB 독립 클론 (대용량, scripts/setup 으로 설치; pob/versions.py 가 커밋 핀 기록) ---
/external/*
!/external/pob/
/external/pob/*
!/external/pob/.gitkeep

# --- Claude Code (개인/로컬 설정) ---
.claude/settings.local.json

# --- 비밀/환경 ---
.env
.env.*
*.pem
poesessid*
secrets.*

# --- OS / 에디터 ---
.DS_Store
Thumbs.db
.vs/
.vscode/
.idea/
*.swp
